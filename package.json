{
  "name": "dataforge-ai",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "workspaces": [
    "backend"
  ],
  "scripts": {
    "dev": "vite",
    "dev:server": "cd backend && pnpm run dev",
    "dev:full": "concurrently \"pnpm run dev\" \"pnpm run dev:server\"",
    "build": "tsc -b && vite build && pnpm run build:backend",
    "build:backend": "cd backend && pnpm run build",
    "start": "cd backend && pnpm run start",
    "preview": "vite preview",
    "install:backend": "cd backend && pnpm install"
  },
  "dependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-icons": "^5.7.0",
    "sleek-toast": "^1.0.31",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.2",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.0",
    "vite": "^6.2.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}